{
  "name": "crumble-pos",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "pos:dev": "pnpm --filter @crumble/pos-desktop dev",
    "pos:smoke": "pnpm --filter @crumble/pos-desktop smoke",
    "mobile:web": "pnpm --filter @crumble/manager-mobile web",
    "mobile:smoke": "pnpm --filter @crumble/manager-mobile smoke",
    "db:test": "bash supabase/tests/run_local.sh"
  }
}
